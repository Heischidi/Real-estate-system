# =============================================================================
# Nigerian Real Estate Alert Platform — Environment Variables
# Copy this file to .env and fill in your values
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
APP_NAME="Nigerian Real Estate Alert Platform"
APP_ENV=production           # development | staging | production
DEBUG=false
SECRET_KEY=change-me-to-a-long-random-secret-key-at-least-32-chars

# -----------------------------------------------------------------------------
# Database — PostgreSQL
# -----------------------------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=realestate
POSTGRES_USER=realestate_user
POSTGRES_PASSWORD=change-me-strong-db-password
DATABASE_URL=postgresql+asyncpg://realestate_user:change-me-strong-db-password@postgres:5432/realestate

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# -----------------------------------------------------------------------------
# Telegram Bot
# -----------------------------------------------------------------------------
# Get this from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=123456789:AABBCCDDEEFFaabbccddeeff-your-bot-token

# Optional: restrict bot to a specific Telegram chat/group ID
# TELEGRAM_ADMIN_CHAT_ID=

# -----------------------------------------------------------------------------
# Admin API Authentication
# -----------------------------------------------------------------------------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-strong-admin-password
JWT_SECRET_KEY=change-me-another-long-random-jwt-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# -----------------------------------------------------------------------------
# Scraper Configuration
# -----------------------------------------------------------------------------
# Seconds to wait between requests to the same domain (be respectful!)
SCRAPER_REQUEST_DELAY_SECONDS=5.0

# Max retries per page before giving up
SCRAPER_MAX_RETRIES=3

# Exponential backoff base (seconds)
SCRAPER_BACKOFF_BASE=2.0

# Playwright browser executable (leave empty for auto-detect)
PLAYWRIGHT_BROWSER=chromium

# Disable scrapers by name (comma-separated) — useful for debugging
# DISABLED_SCRAPERS=property24,privateproperty

# Headless mode for Playwright (true for production)
PLAYWRIGHT_HEADLESS=true

# -----------------------------------------------------------------------------
# Celery Beat Schedule
# -----------------------------------------------------------------------------
# How often to run the full scrape cycle (minutes)
SCRAPE_INTERVAL_MINUTES=15

# How many days to keep old notification logs
NOTIFICATION_RETENTION_DAYS=90

# -----------------------------------------------------------------------------
# CORS (for the FastAPI admin panel)
# -----------------------------------------------------------------------------
CORS_ORIGINS=["http://localhost:3000","https://your-domain.com"]

# -----------------------------------------------------------------------------
# Prometheus Metrics
# -----------------------------------------------------------------------------
METRICS_ENABLED=true
